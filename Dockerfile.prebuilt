FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      iproute2 \
      iptables \
      wireguard-go \
      wireguard-tools \
    && rm -rf /var/lib/apt/lists/*

COPY nse-ovs-vpn /bin/nse-ovs-vpn
ENTRYPOINT ["/bin/nse-ovs-vpn"]
